{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "import", "vitest", "eslint"],
  "jsPlugins": ["./lint-script/oxlint-plugin.js"],
  "options": {
    "typeAware": true
  },
  "rules": {
    "eslint/eqeqeq": ["warn", "always"],
    "eslint/no-alert": "error",
    "eslint/no-console": [
      "warn",
      {
        "allow": ["warn", "error", "info"]
      }
    ],
    "eslint/no-constructor-return": "error",
    "eslint/no-duplicate-imports": "warn",
    "eslint/no-unused-expressions": [
      "warn",
      {
        "allowShortCircuit": true,
        "allowTernary": true,
        "allowTaggedTemplates": true
      }
    ],
    "eslint/no-unused-vars": "off",
    "eslint/prefer-const": [
      "warn",
      {
        "destructuring": "all"
      }
    ],
    "gsa/camelcase": "warn",
    "gsa/filename-convention": "warn",
    "gsa/header": "error",
    "gsa/jsx-sort-props": "warn",
    "gsa/naming-convention": "off",
    "gsa/no-dynamic-i18n": "error",
    "gsa/no-restricted-imports": "warn",
    "gsa/prop-types": "off",
    "import/consistent-type-specifier-style": ["warn", "prefer-inline"],
    "import/newline-after-import": ["warn", {"considerComments": false}],
    "import/no-amd": "error",
    "import/no-absolute-path": "error",
    "import/no-commonjs": "error",
    "import/no-cycle": "error",
    "import/no-unassigned-import": [
      "error",
      {
        "allow": [
          "dayjs/**",
          "whatwg-fetch",
          "@testing-library/jest-dom/vitest"
        ]
      }
    ],
    "react/exhaustive-deps": "warn",
    "react/immutability": "error",
    "react/jsx-fragments": ["warn", "syntax"],
    "react/jsx-key": "warn",
    "react/jsx-no-duplicate-props": "error",
    "react/jsx-props-no-spread-multi": "error",
    "react/no-children-prop": "error",
    "react/no-danger": "error",
    "typescript/no-base-to-string": "error",
    "typescript/consistent-type-exports": "warn",
    "typescript/consistent-type-imports": [
      "error",
      {
        "prefer": "type-imports",
        "fixStyle": "inline-type-imports"
      }
    ],
    "typescript/no-deprecated": "warn",
    "typescript/no-empty-interface": "warn",
    "typescript/no-explicit-any": "warn",
    "typescript/no-floating-promises": "warn",
    "typescript/no-non-null-assertion": "warn",
    "typescript/no-unused-vars": [
      "warn",
      {
        "args": "none",
        "ignoreRestSiblings": true
      }
    ],
    "typescript/restrict-template-expressions": [
      "error",
      {
        "allow": [
          {
            "from": "lib",
            "name": ["Error", "URL", "URLSearchParams"]
          },
          {
            "from": "file",
            "name": "ToString",
            "path": "./src/gmp/types.ts"
          }
        ]
      }
    ],
    "unicorn/no-array-reverse": "warn",
    "unicorn/no-array-sort": "warn",
    "vitest/consistent-test-it": [
      "error",
      {
        "fn": "test"
      }
    ],
    "vitest/no-commented-out-tests": "warn",
    "vitest/no-disabled-tests": "off",
    "vitest/no-focused-tests": "off",
    "vitest/no-identical-title": "error",
    "vitest/valid-expect": "error",
    "vitest/valid-expect-in-promise": "error"
  },
  "overrides": [
    {
      "files": ["**/*.{js,mjs,cjs,jsx}"],
      "rules": {
        "eslint/no-unused-vars": [
          "warn",
          {
            "args": "none",
            "ignoreRestSiblings": true
          }
        ],
        "gsa/camelcase": "warn",
        "gsa/no-dynamic-i18n": "warn",
        "gsa/prop-types": [
          "warn",
          {
            "ignore": ["children", "className", "location"]
          }
        ]
      }
    },
    {
      "files": ["**/*.jsx"],
      "rules": {
        "typescript/no-deprecated": [
          "warn",
          {
            "allow": ["propTypes", "lineDataPropType"]
          }
        ]
      }
    },
    {
      "files": ["**/*.ts", "**/*.tsx"],
      "rules": {
        "gsa/camelcase": "off",
        "gsa/no-dynamic-i18n": "error",
        "gsa/naming-convention": "warn",
        "typescript/no-unused-vars": [
          "warn",
          {
            "args": "none",
            "ignoreRestSiblings": true
          }
        ]
      }
    },
    {
      "files": ["e2e/**/*.ts"],
      "rules": {
        "gsa/no-restricted-imports": "off"
      }
    },
    {
      "files": [
        "**/__tests__/**/*.{js,jsx,ts,tsx}",
        "**/*.{spec,test}.{js,jsx,ts,tsx}"
      ],
      "rules": {
        "gsa/prop-types": "off",
        "vitest/no-disabled-tests": "warn",
        "vitest/no-focused-tests": "error",
        "vitest/no-identical-title": "error"
      }
    }
  ],
  "ignorePatterns": [
    "build/**",
    "node_modules/**",
    "public/**",
    "playwright-report/**",
    "test-results/**",
    "i18next.config.ts",
    "eslint.config.js",
    "vite.config.ts",
    "vitest.config.ts",
    "eslint-script/filename-convention.js"
  ]
}
