{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "import",
    "vitest",
    "eslint"
  ],
  "jsPlugins": [
    "./lint-script/oxlint-plugin.js"
  ],
  "options": {
    "typeAware": true
  },
  "rules": {
    "eslint/no-console": [
      "warn",
      {
        "allow": [
          "warn",
          "error",
          "info"
        ]
      }
    ],
    "gsa/camelcase": "warn",
    "gsa/filename-convention": "warn",
    "gsa/header": "error",
    "gsa/jsx-sort-props": "warn",
    "gsa/naming-convention": "off",
    "gsa/no-dynamic-i18n": "error",
    "gsa/no-restricted-imports": "warn",
    "gsa/prop-types": "off",
    "gsa/ts-definitions-top": "warn",
    "no-unused-vars": "off",
    "eqeqeq": [
      "warn",
      "always"
    ],
    "no-console": [
      "warn",
      {
        "allow": [
          "warn",
          "error",
          "info"
        ]
      }
    ],
    "no-duplicate-imports": "warn",
    "no-unused-expressions": [
      "warn",
      {
        "allowShortCircuit": true,
        "allowTernary": true,
        "allowTaggedTemplates": true
      }
    ],
    "react/exhaustive-deps": "warn",
    "import/consistent-type-specifier-style": [
      "warn",
      "prefer-inline"
    ],
    "import/newline-after-import": ["warn", {"considerComments": true}],
    "react/immutability": "error",
    "react/jsx-fragments": ["warn", "syntax"],
    "react/jsx-key": "warn",
    "react/jsx-no-duplicate-props": "error",
    "react/jsx-props-no-spread-multi": "error",
    "typescript/consistent-type-exports": "warn",
    "typescript/consistent-type-imports": [
      "error",
      {
        "prefer": "type-imports",
        "fixStyle": "inline-type-imports"
      }
    ],
    "typescript/no-empty-interface": "warn",
    "typescript/no-explicit-any": "warn",
    "typescript/no-floating-promises": "warn",
    "typescript/no-non-null-assertion": "warn",
    "typescript/no-unused-vars": [
      "warn",
      {
        "args": "none",
        "ignoreRestSiblings": true
      }
    ],
    "vitest/no-disabled-tests": "off",
    "vitest/no-focused-tests": "off",
    "typescript/restrict-template-expressions": [
      "error",
      {
        "allow": [
          {
            "from": "lib",
            "name": [
              "Error",
              "URL",
              "URLSearchParams"
            ]
          },
          {
            "from": "file",
            "name": "ToString",
            "path": "./src/gmp/types.ts"
          }
        ]
      }
    ],
    "vitest/consistent-test-it": [
      "error",
      {
        "fn": "test"
      }
    ],
    "vitest/valid-expect-in-promise": "error"
  },
  "overrides": [
    {
      "files": [
        "**/*.{js,mjs,cjs,jsx}"
      ],
      "rules": {
        "gsa/camelcase": "warn",
        "gsa/no-dynamic-i18n": "warn",
        "gsa/prop-types": [
          "warn",
          {
            "ignore": [
              "children",
              "className",
              "location"
            ]
          }
        ],
        "no-unused-vars": [
          "warn",
          {
            "args": "none",
            "ignoreRestSiblings": true
          }
        ]
      }
    },
    {
      "files": [
        "**/*.ts",
        "**/*.tsx"
      ],
      "rules": {
        "gsa/camelcase": "off",
        "gsa/no-dynamic-i18n": "error",
        "gsa/naming-convention": "warn",
        "typescript/no-unused-vars": [
          "warn",
          {
            "args": "none",
            "ignoreRestSiblings": true
          }
        ]
      }
    },
    {
      "files": [
        "e2e/**/*.ts"
      ],
      "rules": {
        "gsa/no-restricted-imports": "off"
      }
    },
    {
      "files": [
        "**/__tests__/**/*.{js,jsx,ts,tsx}",
        "**/*.{spec,test}.{js,jsx,ts,tsx}"
      ],
      "rules": {
        "vitest/no-disabled-tests": "warn",
        "vitest/no-focused-tests": "error",
        "vitest/no-identical-title": "error",
        "gsa/prop-types": "off"
      }
    }
  ],
  "ignorePatterns": [
    "build/**",
    "node_modules/**",
    "public/**",
    "playwright-report/**",
    "test-results/**",
    "i18next.config.ts",
    "eslint.config.js",
    "vite.config.ts",
    "vitest.config.ts",
    "eslint-script/filename-convention.js"
  ]
}
